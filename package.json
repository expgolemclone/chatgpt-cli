{
  "name": "gpt-send-messages",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Send locally generated prompts through standalone dedicated Edge profiles on Windows.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "tsc && node --test --test-concurrency=1 tests/*.test.ts",
    "login": "node src/main.ts login",
    "preview": "node src/main.ts send --dry-run",
    "start": "node src/main.ts send"
  },
  "dependencies": {
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
