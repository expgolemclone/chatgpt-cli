{
  "name": "chatgpt-cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Manage dedicated ChatGPT Edge profiles, synchronize private ledgers, and send locally generated prompts on Windows.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "tsc && node --test --test-concurrency=1 tests/*.test.ts",
    "login": "node src/main.ts login",
    "preview": "node src/main.ts send --dry-run",
    "start": "node src/main.ts send"
  },
  "dependencies": {
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "koffi": "3.3.5",
    "playwright": "1.64.1",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "^5.9.0"
  }
}
