{
  "name": "chatgpt-cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Manage dedicated ChatGPT Edge profiles, send prompts, and generate images on Windows.",
  "bin": {
    "chatgpt-cli": "src/main.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "pretest": "node --input-type=module -e \"import { assertStandardUser } from './src/browser/edge.ts'; await assertStandardUser()\"",
    "test": "tsc && node --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "koffi": "3.3.5",
    "playwright": "1.64.1",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "^5.9.0"
  }
}
